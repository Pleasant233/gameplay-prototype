{
  "name": "element-habitat",
  "version": "0.4.0",
  "private": true,
  "description": "Offline Three.js tile placement game prototype",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/python.cjs -m http.server 8080 --bind 0.0.0.0",
    "check": "node scripts/check.cjs",
    "test": "npm run check && node test.js && node test-v13.js && node test-view.js",
    "test:smoke": "node scripts/python.cjs scripts/cloud_smoke.py",
    "test:ui": "node scripts/python.cjs scripts/browser_check.py",
    "test:crystal": "node scripts/python.cjs scripts/crystal_check.py",
    "test:magic": "node scripts/magic_range_check.cjs",
    "test:demolition": "node scripts/demolition_check.cjs",
    "test:large-shield": "node scripts/large_shield_check.cjs",
    "test:atmosphere": "node scripts/python.cjs scripts/atmosphere_check.py",
    "test:browser": "node scripts/python.cjs --suite",
    "test:all": "npm test && npm run test:browser && npm run test:feedback && npm run test:ground",
    "test:gameplay": "node scripts/requirements_check.cjs",
    "test:v1-ui": "node scripts/v1_browser_check.cjs",
    "test:feedback": "node scripts/feedback_check.cjs",
    "test:ground": "node scripts/ground_check.cjs",
    "test:v13-ui": "node scripts/v13_browser_check.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
